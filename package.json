{
  "name": "educoder-task-extractor",
  "private": true,
  "version": "1.0.0",
  "description": "Extract Educoder course experiments and task starter materials to local files.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "pretest": "node tools/build-userscripts.js --check",
    "build:userscripts": "node tools/build-userscripts.js",
    "check": "node tools/check.js",
    "test:browser": "node --test test/userscript-paste.browser.js",
    "test:ui": "node --test test/console-ui.browser.js",
    "extract": "node extractor/run.js",
    "ui": "node extractor/run.js --ui",
    "reminder": "node extractor/reminder.js",
    "check-fit": "node tools/check-answer-fit.js",
    "build-class-answers": "node tools/build-class-answers.js",
    "merge-class-answers": "node tools/merge-class-answers.js",
    "migrate-answers": "node tools/migrate-answers.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "writer": "node extractor/writer-server.js",
    "crawler": "node extractor/traditional-crawler.js"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  }
}
