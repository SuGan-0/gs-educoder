# 本地配置模板。复制为 .env 后填写，**不要提交真实值**。
# 本文件按字面读取：值里的 `$` 不会被当成变量替换。
# 已有环境变量优先于本文件，所以 `EDUCODER_UI_PORT=5000 npm run ui` 这类临时覆盖仍然有效。

# ---- 签名常量（抓取与控制台都需要）----
# 头歌接口必须带签名头。常量来自前端 umi JS 的 setHeader/getKey（双 base64 那串）。
# 不填也能跑：`npm run ui` 首次启动会自动生成控制台 token 并写回本文件；
# 但 AK/SK 必须自己填一次（或用下面的 .educoder-keys.json）。
# 注意：`EDUCODER_UI_TOKEN` 会在首次启动时被自动追加到 .env，不要提交、不要外传。
# EDUCODER_AK=
# EDUCODER_SK=

# ---- 本地控制台（npm run ui）----
# 监听端口。**固定下来**（默认 43127）是为了让篡改猴里配好的地址在重启后依然有效；
# 端口被占用时会回退到系统随机分配（此时地址会变，终端会提示要重配）。
# EDUCODER_UI_PORT=43127
# 访问 token。留空则首次启动随机生成并写回本文件，之后重启不变。
# 它能读写你的答案库，等同于凭据，不要提交、不要外传。
# EDUCODER_UI_TOKEN=

# ---- 投递通道（可选，默认自动判定）----
# local      = 不发手机：待办写成 data/pending-reminders.md，提醒流水写 data/reminders.log
# serverchan = 推到微信（Server 酱），需要下面的 SERVERCHAN_SENDKEY
# 不设置时自动判定：有 SendKey 走 serverchan，没有则走 local。
# REMINDER_CHANNEL=local

# ---- Server 酱（仅在用 serverchan 通道时必填）----
# SendKey。`SCT...` 走 Turbo，`sctp{n}t...` 走 Server 酱³，按前缀自动识别。
# 获取方式：sct.ftqq.com（Turbo）或 sc3.ft07.com（Server 酱³）微信扫码登录后复制。
SERVERCHAN_SENDKEY=

# ---- 提醒策略（必填）----
# 没有截止时间的未完成作业：once = 每个阶段只提醒一次；daily = 每天一次。
UNDATED_REMINDER_MODE=once
# 当日投递次数用尽时：defer = 次日按最新状态重判补发；skip = 跳过当前提醒阶段。
QUOTA_POLICY=defer

# ---- 运行参数（可选，下面是默认值）----
# Server 酱通道的本地日发送上限（Turbo 免费通道最多 5；local 通道不受限）。
SERVERCHAN_DAILY_LIMIT=5
# 全量同步间隔（小时）。
SYNC_INTERVAL_HOURS=6
# 提醒窗口检查间隔（秒）。
REMINDER_CHECK_INTERVAL_SECONDS=60
# 逾期超过多少天的作业不再提醒（0 = 关闭该过滤）。
REMINDER_CUTOFF_DAYS=5

# ---- 本地路径（可选）----
# 数据目录：SQLite 快照、本地待办、提醒流水、进程锁都在这里。
# EDUCODER_DATA_DIR=./data
# 浏览器登录态目录（与 npm run ui 共用）。
# EDUCODER_PROFILE_DIR=./.educoder-browser
# 常驻服务设为 0 可开有头浏览器排查登录问题。
# EDUCODER_HEADLESS=1
